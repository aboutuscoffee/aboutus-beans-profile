# Supabase プロジェクトの設定値を入力してください
# Project Settings → API から取得できます
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理画面のパスワードを自由に設定してください
VITE_ADMIN_PASSWORD=your-password-here

# プッシュ通知用（npx web-push generate-vapid-keys で生成した公開鍵）
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
